-- ====================================================================
-- SISTEMA DE ARRASTE (PC E MOBILE/TOUCH)
-- ====================================================================
local function TornarArrastavel(guiObject)
    local dragging = false
    local dragInput, dragStart, startPos

    guiObject.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = guiObject.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    guiObject.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            guiObject.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
end

TornarArrastavel(MainFrame)
TornarArrastavel(ToggleButton)

-- ====================================================================
-- AÇÕES E EVENTOS
-- ====================================================================
ToggleButton.MouseButton1Click:Connect(function()
    isMenuOpen = not isMenuOpen
    MainFrame.Visible = isMenuOpen
end)

SendButton.MouseButton1Click:Connect(function()
    local texto = InputBox.Text
    if #texto == 0 then
        StatusLabel.Text = "⚠️ Digite alguma frase primeiro!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end

    local tempoAtual = tick()
    if tempoAtual - lastRequestTime < Config.COOLDOWN_TIME then
        local restante = math.ceil(Config.COOLDOWN_TIME - (tempoAtual - lastRequestTime))
        StatusLabel.Text = "⏳ Aguarde " .. restante .. "s para enviar novamente."
        StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
        return
    end

    lastRequestTime = tempoAtual
    SendButton.Text = "Convertendo..."
    StatusLabel.Text = "🔄 Comunicando com a IA..."
    StatusLabel.TextColor3 = Color3.fromRGB(212, 175, 55)

    task.spawn(function()
        local sucesso, resultado = FazerRequisicaoIA(texto)

        if sucesso then
            StatusLabel.Text = "✅ Traduzido: " .. resultado
            StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
            
            EnviarNoChat(resultado)
            InputBox.Text = ""
        else
            StatusLabel.Text = "❌ " .. resultado
            StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        end

        SendButton.Text = "Converter e Enviar"
    end)
end)
