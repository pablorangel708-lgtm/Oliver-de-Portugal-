-- ====================================================================
-- SISTEMA DE ENVIO PARA O CHAT
-- ====================================================================
local function EnviarNoChat(mensagem)
    pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local generalChannel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
            if generalChannel then
                generalChannel:SendAsync(mensagem)
            end
        else
            local sayMessage = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
                and ReplicatedStorage.DefaultChatSystemChatEvents:FindFirstChild("SayMessageRequest")
            if sayMessage then
                sayMessage:FireServer(mensagem, "All")
            end
        end
    end)
end

-- ====================================================================
-- REQUISIÇÃO HTTP (IA)
-- ====================================================================
local function FazerRequisicaoIA(textoOriginal)
    local httpRequest = (syn and syn.request) or (http and http.request) or http_request or request
    
    if not httpRequest then
        return false, "Seu executor não suporta requisições HTTP (função 'request' ausente)."
    end

    local payload = HttpService:JSONEncode({
        model = Config.MODEL,
        messages = {
            { role = "system", content = Config.SYSTEM_PROMPT },
            { role = "user", content = textoOriginal }
        },
        temperature = 0.3
    })

    local response = httpRequest({
        Url = Config.API_URL,
        Method = "POST",
        Headers = {
            ["Content-Type"] = "application/json",
            ["Authorization"] = "Bearer " .. Config.API_KEY
        },
        Body = payload
    })

    if response and response.StatusCode == 200 then
        local data = HttpService:JSONDecode(response.Body)
        if data and data.choices and data.choices[1] and data.choices[1].message then
            local textoConvertido = data.choices[1].message.content
            return true, string.gsub(textoConvertido, "^%s*(.-)%s*$", "%1")
        end
    end

    return false, "Erro na API: " .. tostring(response and response.StatusCode or "Sem resposta")
end

