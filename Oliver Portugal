-- FUNÇÃO GENÉRICA DE ARRASTAR (funciona com mouse e toque/mobile)
-- ===========================================================
local function tornarArrastavel(alvo, pegador)
    pegador = pegador or alvo

    local arrastando = false
    local inicioArraste = nil
    local posicaoInicial = nil

    pegador.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            arrastando = true
            inicioArraste = input.Position
            posicaoInicial = alvo.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    arrastando = false
                end
            end)
        end
    end)

    pegador.InputChanged:Connect(function(input)
        if arrastando and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - inicioArraste
            alvo.Position = UDim2.new(
                posicaoInicial.X.Scale, posicaoInicial.X.Offset + delta.X,
                posicaoInicial.Y.Scale, posicaoInicial.Y.Offset + delta.Y
            )
        end
    end)
end

tornarArrastavel(botaoFlutuante) -- botão flutuante se arrasta pelo próprio corpo
tornarArrastavel(mainFrame, barraTitulo) -- menu se arrasta pela barra de título

