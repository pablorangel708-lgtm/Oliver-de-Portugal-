-- ===========================================================
-- FUNÇÃO DE REQUISIÇÃO HTTP (compatível com vários executores)
-- -----------------------------------------------------------
-- LocalScripts padrão do Roblox não conseguem acessar domínios
-- externos via HttpService (apenas o jogo consegue, se o dono
-- tiver ativado "Allow HTTP Requests"). Por isso, priorizamos as
-- funções de requisição oferecidas pelos executores (que
-- ignoram essa restrição), com fallback para HttpService.
-- ===========================================================
local function requisitarHttp(opcoes)
    local funcaoRequest = (syn and syn.request)
        or (http and http.request)
        or http_request
        or request
        or fluxus and fluxus.request

    if funcaoRequest then
        local sucesso, resposta = pcall(funcaoRequest, opcoes)
        if sucesso then
            return true, resposta
        else
            return false, resposta
        end
    end

    -- Fallback: HttpService padrão (só funciona se o jogo permitir
    -- requisições HTTP e o script rodar em contexto com permissão)
    local sucesso, resposta = pcall(function()
        return HttpService:RequestAsync({
            Url = opcoes.Url,
            Method = opcoes.Method,
            Headers = opcoes.Headers,
            Body = opcoes.Body,
        })
    end)

    if sucesso then
        return true, resposta
    else
        return false, resposta
    end
end

-- ===========================================================
-- FUNÇÃO QUE CHAMA A IA E CONVERTE O TEXTO
-- ===========================================================
local PROMPT_SISTEMA = "Converta este texto de português do Brasil para português europeu. " ..
    "Mantenha o significado, adapte a gramática, vocabulário e expressões para Portugal. " ..
    "Responda apenas com o texto convertido."

local function converterTexto(textoOriginal)
    -- Valida se a configuração foi preenchida
    if Config.API_URL == "" or Config.API_KEY == "" or Config.MODEL == "" then
        return false, "Config.lua incompleto: preencha API_URL, API_KEY e MODEL."
    end

    -- Monta o corpo da requisição no formato "Chat Completions" (OpenAI-compatível)
    local corpoRequisicao = {
        model = Config.MODEL,
        messages = {
            { role = "system", content = PROMPT_SISTEMA },
            { role = "user", content = textoOriginal },
        },
    }

    local corpoJson
    local okEncode, erroEncode = pcall(function()
        corpoJson = HttpService:JSONEncode(corpoRequisicao)
    end)

    if not okEncode then
        return false, "Falha ao montar a requisição (JSONEncode): " .. tostring(erroEncode)
    end

    local sucesso, resposta = requisitarHttp({
        Url = Config.API_URL,
        Method = "POST",
        Headers = {
            ["Content-Type"] = "application/json",
            ["Authorization"] = "Bearer " .. Config.API_KEY,
        },
        Body = corpoJson,
    })

    if not sucesso then
        return false, "Falha na requisição HTTP: " .. tostring(resposta)
    end

    -- Normaliza o corpo da resposta (varia conforme a função usada)
    local corpoResposta = resposta.Body or resposta.body

    if not corpoResposta then
        return false, "Resposta da API veio vazia ou em formato inesperado."
    end

    local okDecode, dadosDecodificados = pcall(function()
        return HttpService:JSONDecode(corpoResposta)
    end)

    if not okDecode then
        return false, "Falha ao interpretar a resposta da API (JSON inválido)."
    end

    -- Extrai o texto da resposta (formato padrão OpenAI-compatível)
    local textoConvertido = dadosDecodificados
        and dadosDecodificados.choices
        and dadosDecodificados.choices[1]
        and dadosDecodificados.choices[1].message
        and dadosDecodificados.choices[1].message.content

    if not textoConvertido or textoConvertido == "" then
        -- Tenta ler uma possível mensagem de erro retornada pela API
        local mensagemErro = dadosDecodificados and dadosDecodificados.error
            and dadosDecodificados.error.message

        return false, mensagemErro or "A API não retornou um texto convertido válido."
    end

    return true, textoConvertido
end

-- ===========================================================
-- ENVIAR MENSAGEM NO CHAT DO ROBLOX
-- ===========================================================
local function enviarNoChat(mensagem)
    local sucesso, erro = pcall(function()
        local textChannel = TextChatService.TextChannels and TextChatService.TextChannels:FindFirstChild("RBXGeneral")

        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService and textChannel then
            -- Sistema de chat novo (TextChatService)
            textChannel:SendAsync(mensagem)
        else
            -- Sistema de chat legado
            local ChatEventoRemoto = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
            if ChatEventoRemoto then
                local sayMessageRequest = ChatEventoRemoto:FindFirstChild("SayMessageRequest")
                if sayMessageRequest then
                    sayMessageRequest:FireServer(mensagem, "All")
                end
            end
        end
    end)

    return sucesso, erro
end

-- ===========================================================
-- LÓGICA DO BOTÃO "CONVERTER E ENVIAR" (com cooldown)
-- ===========================================================
local processando = false

local function atualizarStatus(texto, cor)
    statusLabel.Text = texto
    statusLabel.TextColor3 = cor or COR_TEXTO
end

botaoConverter.MouseButton1Click:Connect(function()
    if processando then
        return
    end

    local agora = os.clock()
    local tempoRestante = COOLDOWN_SEGUNDOS - (agora - ultimoEnvio)

    if tempoRestante > 0 then
        atualizarStatus(string.format("Aguarde %.1fs para enviar novamente.", tempoRestante), COR_ERRO)
        return
    end

    local textoOriginal = textBoxEntrada.Text

    if not textoOriginal or textoOriginal:gsub("%s", "") == "" then
        atualizarStatus("Digite uma frase antes de converter.", COR_ERRO)
        return
    end

    processando = true
    ultimoEnvio = agora
    resultadoLabel.Text = ""
    atualizarStatus("Convertendo...", COR_DOURADO)
    botaoConverter.Text = "Convertendo..."

    -- Executa em uma thread separada para não travar a interface
    task.spawn(function()
        local sucesso, resultado = converterTexto(textoOriginal)

        if sucesso then
            resultadoLabel.Text = resultado
            atualizarStatus("Convertido com sucesso! Enviando no chat...", COR_SUCESSO)

            local sucessoChat, erroChat = enviarNoChat(resultado)

            if sucessoChat then
                atualizarStatus("Mensagem enviada no chat!", COR_SUCESSO)
            else
                atualizarStatus("Convertido, mas falhou ao enviar no chat: " .. tostring(erroChat), COR_ERRO)
            end
        else
            atualizarStatus("Erro: " .. tostring(resultado), COR_ERRO)
        end

        botaoConverter.Text = "Converter e Enviar"
        processando = false
    end)
end)

